      "hour",
      "day_of_week",
      "weekend",
      "distance_km",
      "planned_runtime_min",
      "headway_min",
      "scheduled_runtime_min",
      "capacity_total",
      "prior_route_occupancy_mean",
      "prior_route_hour_occupancy_mean"
    ],
    "categorical": [
      "route_id",
      "vehicle_id",
      "direction",
      "route_type",
      "vehicle_type"
    ]
  },
  "split_dates": {
    "train": [
      "2025-09-01",
      "2026-05-01"
    ],
    "validation": [
      "2026-05-02",
      "2026-07-01"
    ],
    "test": [
      "2026-07-02",
      "2026-08-31"
    ]
  },
  "validation": {
    "mae": 0.142596,
    "rmse": 0.200768,
    "r2": 0.604898,
    "mape_nonzero_pct": 80.865902,
