{
  "task": "occupancy_forecast",
  "algorithm": "ridge",
  "version": "v1",
  "target": "occupancy_pct",
  "target_definition": "trip max_load / vehicle capacity_total",
  "target_unit": "ratio of assigned vehicle capacity",
  "feature_set": "strict_prior_route_and_route_hour_history",
  "features": {
