# ---- Large data files (keep folders, not contents) ----
raw_data/*
processed_data/*
parquet_data/*
!raw_data/.gitkeep
!processed_data/.gitkeep
!parquet_data/.gitkeep
*.parquet
*.csv.gz
*.zip
*.tar.gz
colab_export/

# ---- Model binaries ----
models/*
!models/.gitkeep
# Phase 6 keeps binary Spark model directories local.  Metrics and version manifests are
# deliberately small, reviewable hand-off artefacts for the later MySQL/API phases.
!models/spark/
models/spark/*
!models/spark/metrics/
!models/spark/metrics/*.json
*.pkl
*.joblib
*.h5
*.onnx
*.ubj

# ---- Node / frontend ----
node_modules/
.next/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Generator manifests: commit the small JSON summaries, not the per-row key lists of big modes ----
data_generator/manifests/full/injection_keys.jsonl.gz
data_generator/manifests/hidden_like/injection_keys.jsonl.gz
